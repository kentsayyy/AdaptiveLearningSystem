@model AdaptiveLearningSystem.Models.Quiz
@{
    ViewData["Title"] = "Add Quiz";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Add Quiz</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card" style="max-width:500px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Quiz Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Quiz 1: Basic Fractions" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ModuleId" class="form-label fw-semibold">Module</label>
                <select asp-for="ModuleId" class="form-select" asp-items="ViewBag.Modules">
                    <option value="">-- Select Module --</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="TotalItems" class="form-label fw-semibold">Total Items</label>
                <input asp-for="TotalItems" class="form-control" type="number" min="1" max="100" />
            </div>
            <div class="mb-3">
                <label asp-for="Deadline" class="form-label fw-semibold">Deadline</label>
                <input asp-for="Deadline" class="form-control" type="datetime-local" />
                <span asp-validation-for="Deadline" class="text-danger small"></span>
            </div>
            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary fw-semibold">
                    <i class="bi bi-save me-1"></i>Save Quiz
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
