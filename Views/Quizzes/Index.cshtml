@model IEnumerable<AdaptiveLearningSystem.Models.Quiz>
@{
    ViewData["Title"] = "Quizzes";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e8f0fd;">
            <i class="bi bi-patch-question-fill text-blue"></i>
        </span>
        Quizzes
    </h1>
    <a asp-action="Create" class="btn btn-primary px-4">
        <i class="bi bi-plus-lg me-1"></i>Add Quiz
    </a>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.5rem;width:48px;">#</th>
                            <th>Quiz Title</th>
                            <th>Module</th>
                            <th>Total Items</th>
                            <th>Status</th>
                            <th style="padding-right:1.5rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td style="padding-left:1.5rem;color:#94a3b8;font-size:.82rem;">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width:32px;height:32px;border-radius:8px;background:#e8f0fd;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="bi bi-patch-question" style="color:#0B4FD8;font-size:.9rem;"></i>
                                        </span>
                                        <strong style="color:#1e293b;">@q.Title</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:#e0f2fe;color:#0369a1;">@q.Module?.Title</span>
                                </td>
                                <td style="color:#475569;">
                                    <i class="bi bi-list-check me-1" style="color:#94a3b8;"></i>@q.TotalItems items
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:@(q.IsActive ? "#f0fdf4" : "#f8fafc");color:@(q.IsActive ? "#15803d" : "#64748b");">
                                        <i class="bi bi-@(q.IsActive ? "check-circle" : "dash-circle") me-1"></i>@(q.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="padding-right:1.5rem;">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Edit" asp-route-id="@q.QuizId" class="btn btn-sm" style="background:#fef3c7;color:#92400e;border:none;" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@q.QuizId" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this quiz?')">
                                            <button class="btn btn-sm" style="background:#fff1f2;color:#be123c;border:none;" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon" style="background:#e8f0fd;">
                    <i class="bi bi-patch-question" style="color:#0B4FD8;"></i>
                </div>
                <h6>No quizzes yet</h6>
                <p>Create your first quiz to start assessing student knowledge. <a asp-action="Create" style="color:#0B4FD8;font-weight:600;">Create one?</a></p>
            </div>
        }
    </div>
</div>
