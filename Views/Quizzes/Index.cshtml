@model IEnumerable<AdaptiveLearningSystem.Models.Quiz>
@{
    ViewData["Title"] = "Quizzes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-patch-question-fill me-2 text-primary"></i>Quizzes</h4>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Quiz</a>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Quiz Title</th>
                            <th>Module</th>
                            <th>Total Items</th>
                            <th>Deadline</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var q in Model)
                        {
                            <tr>
                                <td class="text-muted small">@i</td>
                                <td><strong>@q.Title</strong></td>
                                <td><span class="badge bg-info text-dark">@q.Module?.Title</span></td>
                                <td>@q.TotalItems items</td>
                                <td>@q.Deadline.ToString("yyyy-MM-dd HH:mm")</td>
                                <td><span class="badge @(q.IsActive ? "bg-success" : "bg-secondary")">@(q.IsActive ? "Active" : "Inactive")</span></td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@q.QuizId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@q.QuizId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this quiz?')">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-patch-question fs-1"></i>
                <p class="mt-2">No quizzes yet. <a asp-action="Create">Create one?</a></p>
            </div>
        }
    </div>
</div>
