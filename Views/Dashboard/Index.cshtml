@model AdaptiveLearningSystem.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .stat-card {
        border-radius: 14px;
        padding: 1.4rem 1.5rem;
        position: relative;
        overflow: hidden;
        border: none;
        color: #fff;
        box-shadow: 0 4px 16px rgba(0,0,0,.12);
        transition: transform .2s, box-shadow .2s;
    }
    .stat-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,.15); }
    .stat-card::after {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 80% 20%, rgba(255,255,255,.12) 0%, transparent 55%),
                          radial-gradient(circle at 20% 80%, rgba(255,255,255,.07) 0%, transparent 45%);
        pointer-events: none;
    }
    .stat-card .stat-label  { font-size: .78rem; font-weight: 600; opacity: .85; text-transform: uppercase; letter-spacing: .07em; }
    .stat-card .stat-value  { font-size: 2.6rem; font-weight: 800; line-height: 1.1; margin: .2rem 0 .1rem; }
    .stat-card .stat-icon   { position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); font-size: 3rem; opacity: .18; }
    .stat-card .stat-sub    { font-size: .78rem; opacity: .75; }

    .stat-blue  { background: linear-gradient(135deg, #0B4FD8 0%, #1d6feb 100%); }
    .stat-teal  { background: linear-gradient(135deg, #0D9E6E 0%, #14b87f 100%); }
    .stat-cyan  { background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%); }
    .stat-amber { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }

    .section-card { border-radius: 12px; border: 1px solid #e5e9f0; box-shadow: 0 1px 4px rgba(0,0,0,.05); background: #fff; }
    .section-card .section-header {
        padding: .875rem 1.25rem;
        border-radius: 12px 12px 0 0;
        display: flex; align-items: center; justify-content: space-between;
        font-weight: 600; font-size: .9rem;
    }
    .section-card .section-header i { font-size: 1rem; }

    .score-pill {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 700;
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e8f0fd;">
            <i class="bi bi-speedometer2 text-blue"></i>
        </span>
        Learning Analytics Dashboard
    </h1>
    <span class="sdg-badge"><i class="bi bi-patch-check me-1"></i>SDG 4 · Quality Education</span>
</div>

<!-- Summary Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="stat-card stat-blue">
            <div class="stat-label">Total Students</div>
            <div class="stat-value">@Model.TotalStudents</div>
            <div class="stat-sub">Enrolled learners</div>
            <i class="bi bi-people-fill stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stat-teal">
            <div class="stat-label">Total Modules</div>
            <div class="stat-value">@Model.TotalModules</div>
            <div class="stat-sub">Learning modules</div>
            <i class="bi bi-journal-bookmark-fill stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stat-cyan">
            <div class="stat-label">Completed</div>
            <div class="stat-value">@Model.TotalCompleted</div>
            <div class="stat-sub">Finished modules</div>
            <i class="bi bi-check-circle-fill stat-icon"></i>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="stat-card stat-amber">
            <div class="stat-label">Avg Score</div>
            <div class="stat-value">@Model.AverageScore<span style="font-size:1.4rem;">%</span></div>
            <div class="stat-sub">Class average</div>
            <i class="bi bi-bar-chart-fill stat-icon"></i>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Struggling Students -->
    <div class="col-md-7">
        <div class="section-card h-100">
            <div class="section-header" style="background:#fff1f2; color:#be123c; border-bottom:1px solid #fecdd3;">
                <span><i class="bi bi-exclamation-triangle-fill me-2"></i>Students Needing Support <span style="font-size:.78rem; opacity:.7;">(Score &lt; 75)</span></span>
                <span style="background:#be123c; color:#fff; border-radius:20px; padding:2px 10px; font-size:.78rem;">@Model.StrugglingStudents.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.StrugglingStudents.Any())
                {
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th style="padding-left:1.25rem;">Student</th>
                                    <th>Module</th>
                                    <th>Score</th>
                                    <th>Recommendation</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.StrugglingStudents)
                                {
                                    <tr>
                                        <td style="padding-left:1.25rem;">
                                            <span class="d-inline-flex align-items-center gap-2">
                                                <span style="width:30px;height:30px;border-radius:50%;background:#e8f0fd;display:inline-flex;align-items:center;justify-content:center;font-size:.75rem;font-weight:700;color:#0B4FD8;">
                                                    @(p.User?.FullName?.Substring(0,1).ToUpper() ?? "?")
                                                </span>
                                                @p.User?.FullName
                                            </span>
                                        </td>
                                        <td class="text-truncate" style="max-width:120px;">@p.Module?.Title</td>
                                        <td><span class="score-pill" style="background:#fff1f2;color:#be123c;">@p.QuizScore%</span></td>
                                        <td><span class="badge rounded-pill" style="background:#fef3c7;color:#92400e;">@p.Recommendation</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon" style="background:#f0fdf4;">
                            <i class="bi bi-emoji-smile-fill" style="color:#0D9E6E;"></i>
                        </div>
                        <h6>All students on track!</h6>
                        <p>No students below the 75% mastery threshold.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Inactive Students -->
    <div class="col-md-5">
        <div class="section-card h-100">
            <div class="section-header" style="background:#f8fafc; color:#475569; border-bottom:1px solid #e5e9f0;">
                <span><i class="bi bi-clock-history me-2"></i>Inactive (7+ days)</span>
                <span style="background:#64748b; color:#fff; border-radius:20px; padding:2px 10px; font-size:.78rem;">@Model.InactiveStudents.Count</span>
            </div>
            <div class="card-body p-0">
                @if (Model.InactiveStudents.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var s in Model.InactiveStudents.Take(8))
                        {
                            <li class="list-group-item border-0" style="border-bottom:1px solid #f1f5f9 !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <span style="width:34px;height:34px;border-radius:50%;background:#f1f5f9;display:inline-flex;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;color:#64748b;flex-shrink:0;">
                                        @(s.FullName?.Substring(0,1).ToUpper() ?? "?")
                                    </span>
                                    <div>
                                        <div class="fw-semibold" style="font-size:.875rem;color:#1e293b;">@s.FullName</div>
                                        <div style="font-size:.75rem;color:#94a3b8;">@s.Email</div>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="empty-state">
                        <div class="empty-state-icon" style="background:#e6f7f1;">
                            <i class="bi bi-activity" style="color:#0D9E6E;"></i>
                        </div>
                        <h6>Everyone's active!</h6>
                        <p>All students have logged in within the last 7 days.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Recent Activity -->
@if (Model.RecentProgress.Any())
{
    <div class="section-card mt-4">
        <div class="section-header" style="background:#e8f0fd; color:#0B4FD8; border-bottom:1px solid #c7d9fb;">
            <span><i class="bi bi-clock me-2"></i>Recent Activity</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.25rem;">Student</th>
                            <th>Module</th>
                            <th>Quiz</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th>Recommendation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentProgress)
                        {
                            <tr>
                                <td style="padding-left:1.25rem;">@p.User?.FullName</td>
                                <td class="text-truncate" style="max-width:120px;">@p.Module?.Title</td>
                                <td class="text-truncate" style="max-width:100px;">@p.Quiz?.Title</td>
                                <td>
                                    <span class="score-pill" style="background:@(p.QuizScore >= 75 ? "#f0fdf4" : "#fff1f2");color:@(p.QuizScore >= 75 ? "#15803d" : "#be123c");">
                                        @p.QuizScore%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(p.CompletionStatus == "Completed" ? "bg-success" : "bg-secondary")">
                                        @p.CompletionStatus
                                    </span>
                                </td>
                                <td style="color:#94a3b8;font-size:.82rem;">@p.DateCompleted.ToShortDateString()</td>
                                <td>
                                    <span class="badge rounded-pill" style="background:#fef3c7;color:#92400e;">@p.Recommendation</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
