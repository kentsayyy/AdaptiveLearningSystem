@model IEnumerable<AdaptiveLearningSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Students";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e8f0fd;">
            <i class="bi bi-people-fill text-blue"></i>
        </span>
        Student Records
    </h1>
    <span class="badge rounded-pill px-3 py-2" style="background:#e8f0fd;color:#0B4FD8;font-size:.85rem;">
        <i class="bi bi-person-fill me-1"></i>@Model.Count() students
    </span>
</div>

<!-- Search Bar -->
<div class="filter-bar mb-3">
    <form method="get" class="d-flex align-items-center gap-3">
        <div class="input-group" style="max-width:380px;">
            <span class="input-group-text" style="background:#f8fafc;border-color:#e2e8f0;border-right:none;">
                <i class="bi bi-search" style="color:#94a3b8;"></i>
            </span>
            <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email…"
                   style="border-left:none;background:#f8fafc;" />
        </div>
        <button class="btn btn-primary px-4">Search</button>
        @if (!string.IsNullOrEmpty(ViewBag.Search?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </form>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.5rem;width:48px;">#</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Registered</th>
                            <th style="padding-right:1.5rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td style="padding-left:1.5rem;color:#94a3b8;font-size:.82rem;">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <span style="width:36px;height:36px;border-radius:50%;background:#e8f0fd;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.82rem;color:#0B4FD8;flex-shrink:0;">
                                            @(s.FullName?.Substring(0,1).ToUpper() ?? "?")
                                        </span>
                                        <strong style="color:#1e293b;">@s.FullName</strong>
                                    </div>
                                </td>
                                <td style="color:#64748b;">@s.Email</td>
                                <td style="color:#94a3b8;font-size:.82rem;">@s.DateRegistered.ToShortDateString()</td>
                                <td style="padding-right:1.5rem;">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm" style="background:#e8f0fd;color:#0B4FD8;border:none;" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm" style="background:#fef3c7;color:#92400e;border:none;" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete @s.FullName? This cannot be undone.')">
                                            <button class="btn btn-sm" style="background:#fff1f2;color:#be123c;border:none;" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon" style="background:#e8f0fd;">
                    <i class="bi bi-people" style="color:#0B4FD8;"></i>
                </div>
                <h6>No students found</h6>
                <p>@(string.IsNullOrEmpty(ViewBag.Search?.ToString()) ? "No students have registered yet." : $"No results for \"{ViewBag.Search}\". Try a different search.")</p>
            </div>
        }
    </div>
</div>
