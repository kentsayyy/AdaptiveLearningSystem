@model IEnumerable<AdaptiveLearningSystem.Models.ApplicationUser>
@{
    ViewData["Title"] = "Students";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>Student Records</h4>
    <span class="badge bg-primary rounded-pill px-3">@Model.Count() students</span>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex gap-2">
            <div class="input-group" style="max-width:350px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email..." />
            </div>
            <button class="btn btn-primary">Search</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search))
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
            }
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Registered</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var s in Model)
                        {
                            <tr>
                                <td class="text-muted small">@i</td>
                                <td><i class="bi bi-person-circle me-2 text-primary"></i><strong>@s.FullName</strong></td>
                                <td>@s.Email</td>
                                <td class="small text-muted">@s.DateRegistered.ToShortDateString()</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete @s.FullName? This cannot be undone.')">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-people fs-1"></i>
                <p class="mt-2">No students found.</p>
            </div>
        }
    </div>
</div>
