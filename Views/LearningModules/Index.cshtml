@model IEnumerable<AdaptiveLearningSystem.Models.LearningModule>
@{
    ViewData["Title"] = "Learning Modules";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e6f7f1;">
            <i class="bi bi-journal-bookmark-fill text-teal"></i>
        </span>
        Learning Modules
    </h1>
    <a asp-action="Create" class="btn btn-success px-4">
        <i class="bi bi-plus-lg me-1"></i>Add Module
    </a>
</div>

<!-- Filter Bar -->
<div class="filter-bar mb-3">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label">Subject</label>
            <select name="subject" class="form-select form-select-sm" style="min-width:160px;">
                <option value="">All Subjects</option>
                @foreach (var s in (ViewBag.Subjects as List<string> ?? new List<string>()))
                {
                    <option value="@s" selected="@(ViewBag.SelectedSubject == s ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div>
            <label class="form-label">Level</label>
            <select name="level" class="form-select form-select-sm" style="min-width:140px;">
                <option value="">All Levels</option>
                <option value="Basic"    selected="@(ViewBag.SelectedLevel == "Basic"    ? "selected" : null)">Basic</option>
                <option value="Advanced" selected="@(ViewBag.SelectedLevel == "Advanced" ? "selected" : null)">Advanced</option>
            </select>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm px-4">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.5rem;width:48px;">#</th>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th style="padding-right:1.5rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td style="padding-left:1.5rem;color:#94a3b8;font-size:.82rem;">@i</td>
                                <td>
                                    <strong style="color:#1e293b;">@m.Title</strong>
                                    <div style="font-size:.78rem;color:#94a3b8;margin-top:1px;">
                                        @m.Description.Substring(0, Math.Min(55, m.Description.Length))…
                                    </div>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:#e0f2fe;color:#0369a1;">@m.Subject</span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill @(m.Level == "Advanced" ? "" : "")"
                                          style="background:@(m.Level == "Advanced" ? "#fff1f2" : "#f1f5f9");color:@(m.Level == "Advanced" ? "#be123c" : "#475569");">
                                        @m.Level
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:@(m.IsActive ? "#f0fdf4" : "#f8fafc");color:@(m.IsActive ? "#15803d" : "#64748b");">
                                        <i class="bi bi-@(m.IsActive ? "check-circle" : "dash-circle") me-1"></i>@(m.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td style="color:#94a3b8;font-size:.82rem;">@m.DateCreated.ToShortDateString()</td>
                                <td style="padding-right:1.5rem;">
                                    <div class="d-flex gap-1">
                                        <a asp-action="Details" asp-route-id="@m.ModuleId" class="btn btn-sm" style="background:#e8f0fd;color:#0B4FD8;border:none;" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@m.ModuleId" class="btn btn-sm" style="background:#fef3c7;color:#92400e;border:none;" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@m.ModuleId" method="post" class="d-inline"
                                              onsubmit="return confirm('Delete this module?')">
                                            <button class="btn btn-sm" style="background:#fff1f2;color:#be123c;border:none;" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon" style="background:#e6f7f1;">
                    <i class="bi bi-journal-bookmark" style="color:#0D9E6E;"></i>
                </div>
                <h6>No modules found</h6>
                <p>Get started by <a asp-action="Create" style="color:#0D9E6E;font-weight:600;">creating your first module</a>.</p>
            </div>
        }
    </div>
</div>
