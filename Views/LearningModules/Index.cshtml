@model IEnumerable<AdaptiveLearningSystem.Models.LearningModule>
@{
    ViewData["Title"] = "Learning Modules";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-journal-bookmark-fill me-2 text-success"></i>Learning Modules</h4>
    <a asp-action="Create" class="btn btn-success btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Add Module
    </a>
</div>

<!-- Filter Form -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form method="get" class="d-flex flex-wrap gap-2 align-items-end">
            <div>
                <label class="form-label small mb-1">Subject</label>
                <select name="subject" class="form-select form-select-sm" style="min-width:150px;">
                    <option value="">All Subjects</option>
                    @foreach (var s in (ViewBag.Subjects as List<string> ?? new List<string>()))
                    {
                        <option value="@s" selected="@(ViewBag.SelectedSubject == s ? "selected" : null)">@s</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label small mb-1">Level</label>
                <select name="level" class="form-select form-select-sm" style="min-width:130px;">
                    <option value="">All Levels</option>
                    <option value="Basic" selected="@(ViewBag.SelectedLevel == "Basic" ? "selected" : null)">Basic</option>
                    <option value="Advanced" selected="@(ViewBag.SelectedLevel == "Advanced" ? "selected" : null)">Advanced</option>
                </select>
            </div>
            <div class="d-flex gap-2 align-self-end">
                <button class="btn btn-primary btn-sm">Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Title</th>
                            <th>Subject</th>
                            <th>Level</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var m in Model)
                        {
                            <tr>
                                <td class="text-muted small">@i</td>
                                <td><strong>@m.Title</strong><br/><small class="text-muted">@m.Description.Substring(0, Math.Min(50, m.Description.Length))…</small></td>
                                <td><span class="badge bg-info text-dark">@m.Subject</span></td>
                                <td>
                                    <span class="badge @(m.Level == "Advanced" ? "bg-danger" : "bg-secondary")">@m.Level</span>
                                </td>
                                <td>
                                    <span class="badge @(m.IsActive ? "bg-success" : "bg-secondary")">
                                        @(m.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                                <td class="small text-muted">@m.DateCreated.ToShortDateString()</td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@m.ModuleId" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@m.ModuleId" class="btn btn-sm btn-outline-warning"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@m.ModuleId" method="post" class="d-inline"
                                          onsubmit="return confirm('Delete this module?')">
                                        <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-journal-x fs-1"></i>
                <p class="mt-2">No modules found. <a asp-action="Create">Create one?</a></p>
            </div>
        }
    </div>
</div>
