@model AdaptiveLearningSystem.Models.LearningModule
@{
    ViewData["Title"] = "Add Module";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-success"></i>Add Learning Module</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card" style="max-width:560px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Module Title</label>
                <input asp-for="Title" class="form-control" placeholder="e.g. Introduction to Fractions" />
                <span asp-validation-for="Title" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Subject" class="form-label fw-semibold">Subject</label>
                <input asp-for="Subject" class="form-control" placeholder="e.g. Mathematics, Science, English" />
                <span asp-validation-for="Subject" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Level" class="form-label fw-semibold">Level</label>
                <select asp-for="Level" class="form-select">
                    <option value="Basic">Basic</option>
                    <option value="Advanced">Advanced</option>
                </select>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief description of this module..."></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>
            @* Teacher selection is only available to admins. Teachers creating a module are assigned automatically. *@
            @if (User.IsInRole("Admin"))
            {
                <div class="mb-3">
                    <label asp-for="TeacherId" class="form-label fw-semibold">Teacher</label>
                    <select asp-for="TeacherId" class="form-select" asp-items="ViewBag.Teachers">
                        <option value="">-- Select Teacher --</option>
                    </select>
                    <span asp-validation-for="TeacherId" class="text-danger small"></span>
                </div>
            }
            <div class="mb-4 form-check">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success fw-semibold">
                    <i class="bi bi-save me-1"></i>Save Module
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
