@model IEnumerable<AdaptiveLearningSystem.Models.StudentProgress>
@{
    ViewData["Title"] = "Progress Records";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e8f0fd;">
            <i class="bi bi-bar-chart-fill text-blue"></i>
        </span>
        Student Progress Records
    </h1>
    <a asp-action="Create" class="btn btn-primary px-4">
        <i class="bi bi-plus-lg me-1"></i>Record Progress
    </a>
</div>

<!-- Filter Bar -->
<div class="filter-bar mb-3">
    <form method="get" class="d-flex flex-wrap gap-3 align-items-end">
        <div>
            <label class="form-label">Student Name</label>
            <input name="studentName" class="form-control form-control-sm" value="@ViewBag.StudentName"
                   placeholder="Search…" style="min-width:170px;" />
        </div>
        <div>
            <label class="form-label">Status</label>
            <select name="status" class="form-select form-select-sm" style="min-width:150px;">
                <option value="">All Status</option>
                <option value="In Progress" selected="@(ViewBag.Status == "In Progress" ? "selected" : null)">In Progress</option>
                <option value="Completed"   selected="@(ViewBag.Status == "Completed"   ? "selected" : null)">Completed</option>
            </select>
        </div>
        <div>
            <label class="form-label">From Date</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@ViewBag.FromDate" />
        </div>
        <div>
            <label class="form-label">To Date</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@ViewBag.ToDate" />
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary btn-sm px-4">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Clear</a>
        </div>
    </form>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.5rem;">Student</th>
                            <th>Module</th>
                            <th>Quiz</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th>Date</th>
                            <th style="padding-right:1.5rem;">Recommendation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td style="padding-left:1.5rem;">
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width:32px;height:32px;border-radius:50%;background:#e8f0fd;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.75rem;color:#0B4FD8;flex-shrink:0;">
                                            @(p.User?.FullName?.Substring(0,1).ToUpper() ?? "?")
                                        </span>
                                        <span style="color:#1e293b;font-weight:500;">@p.User?.FullName</span>
                                    </div>
                                </td>
                                <td class="text-truncate" style="max-width:130px;color:#475569;">@p.Module?.Title</td>
                                <td class="text-truncate" style="max-width:120px;color:#475569;">@p.Quiz?.Title</td>
                                <td>
                                    <span style="display:inline-block;padding:3px 10px;border-radius:20px;font-size:.78rem;font-weight:700;background:@(p.QuizScore >= 75 ? "#f0fdf4" : "#fff1f2");color:@(p.QuizScore >= 75 ? "#15803d" : "#be123c");">
                                        @p.QuizScore%
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" style="background:@(p.CompletionStatus == "Completed" ? "#f0fdf4" : "#fef3c7");color:@(p.CompletionStatus == "Completed" ? "#15803d" : "#92400e");">
                                        @p.CompletionStatus
                                    </span>
                                </td>
                                <td style="color:#94a3b8;font-size:.82rem;">@p.DateCompleted.ToShortDateString()</td>
                                <td style="padding-right:1.5rem;">
                                    <span class="badge rounded-pill" style="background:@(p.QuizScore >= 75 ? "#f0fdf4" : "#fef3c7");color:@(p.QuizScore >= 75 ? "#15803d" : "#92400e");">
                                        @p.Recommendation
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon" style="background:#e8f0fd;">
                    <i class="bi bi-bar-chart" style="color:#0B4FD8;"></i>
                </div>
                <h6>No progress records found</h6>
                <p>@(string.IsNullOrEmpty(ViewBag.StudentName?.ToString()) && string.IsNullOrEmpty(ViewBag.Status?.ToString()) ? "Start recording student quiz scores and completion data." : "Try adjusting your filters to find records.")</p>
            </div>
        }
    </div>
</div>
