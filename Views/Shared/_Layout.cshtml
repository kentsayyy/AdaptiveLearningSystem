<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AdaptLearn PH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --blue:  #0B4FD8;
            --teal:  #0D9E6E;
            --blue-soft: #e8f0fd;
            --teal-soft: #e6f7f1;
            --sidebar-w: 230px;
        }

        body { background-color: #f0f2f5; font-family: system-ui, -apple-system, sans-serif; }

        /* ── NAVBAR ──────────────────────────────────────────────────── */
        .navbar-brand { font-weight: 700; font-size: 1.2rem; letter-spacing: -.01em; }
        .navbar-user  { font-size: .85rem; opacity: .85; }

        .navbar-home {
            background: transparent !important;
            backdrop-filter: blur(8px);
            position: absolute !important;
            width: 100%; top: 0; left: 0; z-index: 999;
        }
        .navbar-home .navbar-brand,
        .navbar-home .nav-link,
        .navbar-home .text-white-50 { color: #fff !important; }

        .navbar-auth { background: #ffffff !important; border-bottom: 1px solid #dee2e6; }
        .navbar-auth .navbar-brand,
        .navbar-auth .nav-link { color: var(--blue) !important; }
        .navbar-auth .navbar-toggler { border-color: rgba(11,79,216,.3); }
        .navbar-auth .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba%2811%2C79%2C216%2C0.85%29' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* ── SIDEBAR ─────────────────────────────────────────────────── */
        .sidebar {
            width: var(--sidebar-w);
            min-height: calc(100vh - 56px);
            background: #ffffff;
            border-right: 1px solid #e5e9f0;
            padding: 1.25rem .75rem;
            position: sticky;
            top: 56px;
            height: calc(100vh - 56px);
            overflow-y: auto;
        }
        .sidebar-section-label {
            font-size: .68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .09em;
            color: #94a3b8;
            padding: .5rem .75rem .25rem;
            margin-top: .5rem;
        }
        .sidebar .nav-link {
            color: #475569;
            border-radius: 8px;
            margin-bottom: 1px;
            padding: 9px 14px;
            font-size: .875rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: all .15s ease;
        }
        .sidebar .nav-link i { font-size: 1rem; flex-shrink: 0; }
        .sidebar .nav-link:hover {
            background: var(--blue-soft);
            color: var(--blue);
        }
        .sidebar .nav-link.active {
            background: var(--blue);
            color: #fff;
            box-shadow: 0 2px 8px rgba(11,79,216,.25);
        }
        .sidebar .nav-link.active i { color: #fff; }

        /* ── MAIN CONTENT ────────────────────────────────────────────── */
        .main-content { padding: 1.75rem 2rem; flex: 1; min-width: 0; }

        /* ── CARDS ───────────────────────────────────────────────────── */
        .card {
            border: 1px solid #e5e9f0;
            box-shadow: 0 1px 4px rgba(0,0,0,.05);
            border-radius: 12px;
            background: #fff;
        }
        .card-stat h2 { font-size: 2.4rem; font-weight: 800; }

        /* ── TABLES ──────────────────────────────────────────────────── */
        .table th {
            font-weight: 600;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .06em;
            color: #64748b;
            border-bottom: 2px solid #e5e9f0 !important;
            background: #f8fafc;
        }
        .table td { vertical-align: middle; font-size: .9rem; border-color: #f1f5f9; }
        .table tbody tr { transition: background .1s; }
        .table tbody tr:hover { background: #f8fafc; }

        /* ── PAGE HEADER ─────────────────────────────────────────────── */
        .page-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 1.5rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f1f5f9;
        }
        .page-header-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .page-header-title .title-icon {
            width: 38px; height: 38px;
            border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

        /* ── FILTER BAR ──────────────────────────────────────────────── */
        .filter-bar {
            background: #fff;
            border: 1px solid #e5e9f0;
            border-radius: 12px;
            padding: .875rem 1.25rem;
            margin-bottom: 1rem;
        }
        .filter-bar .form-label { font-size: .78rem; font-weight: 600; color: #64748b; margin-bottom: 3px; }
        .filter-bar .form-control,
        .filter-bar .form-select { font-size: .875rem; border-color: #e2e8f0; border-radius: 8px; }
        .filter-bar .form-control:focus,
        .filter-bar .form-select:focus { border-color: var(--blue); box-shadow: 0 0 0 3px rgba(11,79,216,.1); }

        /* ── EMPTY STATE ─────────────────────────────────────────────── */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
        }
        .empty-state-icon {
            width: 72px; height: 72px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.25rem;
            font-size: 1.75rem;
        }
        .empty-state h6 { font-weight: 700; color: #1e293b; margin-bottom: .35rem; }
        .empty-state p  { color: #94a3b8; font-size: .9rem; margin: 0; }

        /* ── ALERTS ──────────────────────────────────────────────────── */
        .alert-temp { position: fixed; top: 70px; right: 20px; z-index: 9999; min-width: 300px; border-radius: 10px; }

        /* ── BADGES ──────────────────────────────────────────────────── */
        .badge { font-weight: 600; letter-spacing: .02em; }

        /* ── BUTTONS ─────────────────────────────────────────────────── */
        .btn { border-radius: 8px; font-weight: 500; font-size: .875rem; }
        .btn-primary   { background: var(--blue);  border-color: var(--blue);  }
        .btn-success   { background: var(--teal);  border-color: var(--teal);  }
        .btn-primary:hover  { background: #0941b8; border-color: #0941b8; }
        .btn-success:hover  { background: #0a8a5e; border-color: #0a8a5e; }

        /* ── SDG BADGE ───────────────────────────────────────────────── */
        .sdg-badge {
            background: linear-gradient(135deg, var(--teal), var(--blue));
            color: white; border-radius: 20px;
            padding: 5px 14px; font-size: .78rem; font-weight: 600;
        }

        /* Misc */
        .text-blue { color: var(--blue) !important; }
        .text-teal { color: var(--teal) !important; }
        .bg-blue-soft { background: var(--blue-soft); }
        .bg-teal-soft { background: var(--teal-soft); }
    </style>
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action     = ViewContext.RouteData.Values["action"]?.ToString();

        bool isAuthPage = controller == "Account";
        bool isHomePage = controller == "Home" && action == "Index";

        string navClass = isHomePage ? "navbar-home navbar-dark"
                        : isAuthPage ? "navbar-auth navbar-light"
                        :              "navbar-dark bg-primary";
    }

    <nav class="navbar navbar-expand-lg @navClass" id="mainNavbar" style="@(isHomePage ? "" : "position:sticky;top:0;z-index:1030;")">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><i class="bi bi-mortarboard-fill me-2"></i>AdaptLearn PH</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center gap-2">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link navbar-user">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light px-3">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex" style="min-height:calc(100vh - 56px);">
            <!-- Sidebar -->
            <div class="sidebar d-none d-md-flex flex-column">
                <nav class="nav flex-column">
                    <a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-speedometer2"></i>Dashboard
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                    {
                        <div class="sidebar-section-label">Management</div>
                        <a class="nav-link @(controller == "Students" ? "active" : "")" asp-controller="Students" asp-action="Index">
                            <i class="bi bi-people"></i>Students
                        </a>
                        <a class="nav-link @(controller == "LearningModules" ? "active" : "")" asp-controller="LearningModules" asp-action="Index">
                            <i class="bi bi-journal-bookmark"></i>Modules
                        </a>
                        <a class="nav-link @(controller == "Quizzes" ? "active" : "")" asp-controller="Quizzes" asp-action="Index">
                            <i class="bi bi-patch-question"></i>Quizzes
                        </a>
                        <a class="nav-link @(controller == "Enrollments" ? "active" : "")" asp-controller="Enrollments" asp-action="Index">
                            <i class="bi bi-person-check"></i>Enrollments
                        </a>
                        <a class="nav-link @(controller == "StudentProgress" ? "active" : "")" asp-controller="StudentProgress" asp-action="Index">
                            <i class="bi bi-bar-chart"></i>Progress Records
                        </a>
                    }

                    @if (User.IsInRole("Student"))
                    {
                        <div class="sidebar-section-label">My Learning</div>
                        <a class="nav-link @(controller == "Enrollments" && action == "MyModules" ? "active" : "")" asp-controller="Enrollments" asp-action="MyModules">
                            <i class="bi bi-book"></i>My Modules
                        </a>
                        <a class="nav-link @(controller == "StudentProgress" && action == "Create" ? "active" : "")" asp-controller="StudentProgress" asp-action="Create">
                            <i class="bi bi-plus-circle"></i>Record Progress
                        </a>
                    }
                </nav>
            </div>

            <!-- Main Content -->
            <div class="main-content flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible alert-temp fade show shadow" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert-temp').forEach(el => {
                var alert = new bootstrap.Alert(el);
                alert.close();
            });
        }, 4000);
    </script>
</body>
</html>
