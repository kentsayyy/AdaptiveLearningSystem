<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — AdaptLearn PH</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: 700; font-size: 1.3rem; }
        .sidebar { min-height: calc(100vh - 56px); background: #fff; border-right: 1px solid #dee2e6; padding-top: 1rem; }
        .sidebar .nav-link { color: #495057; border-radius: 8px; margin-bottom: 2px; padding: 8px 16px; }
        .sidebar .nav-link i { width: 20px; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { background-color: #e7f1ff; color: #0d6efd; }
        .main-content { padding: 2rem; }
        .card { border: none; box-shadow: 0 2px 8px rgba(0,0,0,.08); border-radius: 12px; }
        .card-stat h2 { font-size: 2.5rem; font-weight: 700; }
        .table th { font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: .05em; }
        .alert-temp { position: fixed; top: 70px; right: 20px; z-index: 9999; min-width: 280px; }
        .sdg-badge { background: linear-gradient(135deg, #198754, #0d6efd); color: white; border-radius: 8px; padding: 4px 10px; font-size: 0.78rem; }

        /* Navbar transparent for landing page */
        .navbar-home {
            background: transparent !important;
            backdrop-filter: blur(8px);
            position: absolute !important;
            width: 100%;
            top: 0; left: 0;
            z-index: 999;
        }
        .navbar-home .navbar-brand,
        .navbar-home .nav-link,
        .navbar-home .text-white-50 {
            color: #fff !important;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary" id="mainNavbar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/"><i class="bi bi-mortarboard-fill me-2"></i>AdaptLearn PH</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white-50">
                                <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                            </span>
                        </li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">
                                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                                </button>
                            </form>
                        </li>
                    }
                    @* Login/Register buttons removed — available on landing page hero *@
                </ul>
            </div>
        </div>
    </nav>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="container-fluid">
            <div class="row">
                <!-- Sidebar -->
                <div class="col-md-2 sidebar d-none d-md-block">
                    <nav class="nav flex-column">
                        <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                        @if (User.IsInRole("Admin") || User.IsInRole("Teacher"))
                        {
                            <div class="nav-link text-muted small fw-bold mt-3 mb-1 px-2" style="font-size:.7rem;text-transform:uppercase;letter-spacing:.08em;">Management</div>
                            <a class="nav-link" asp-controller="Students" asp-action="Index">
                                <i class="bi bi-people me-2"></i>Students
                            </a>
                            <a class="nav-link" asp-controller="LearningModules" asp-action="Index">
                                <i class="bi bi-journal-bookmark me-2"></i>Modules
                            </a>
                            <a class="nav-link" asp-controller="Quizzes" asp-action="Index">
                                <i class="bi bi-patch-question me-2"></i>Quizzes
                            </a>
                            <a class="nav-link" asp-controller="Enrollments" asp-action="Index">
                                <i class="bi bi-person-check me-2"></i>Enrollments
                            </a>
                            <a class="nav-link" asp-controller="StudentProgress" asp-action="Index">
                                <i class="bi bi-bar-chart me-2"></i>Progress Records
                            </a>
                        }
                        @if (User.IsInRole("Student"))
                        {
                            <a class="nav-link" asp-controller="Enrollments" asp-action="MyModules">
                                <i class="bi bi-book me-2"></i>My Modules
                            </a>
                            <a class="nav-link" asp-controller="StudentProgress" asp-action="Create">
                                <i class="bi bi-plus-circle me-2"></i>Record Progress
                            </a>
                        }
                    </nav>
                </div>
                <!-- Main Content -->
                <div class="col-md-10 main-content">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible alert-temp fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </div>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        setTimeout(function () {
            document.querySelectorAll('.alert-temp').forEach(el => {
                var alert = new bootstrap.Alert(el);
                alert.close();
            });
        }, 4000);
    </script>
</body>
</html>
