@using Microsoft.AspNetCore.Identity
@using AdaptiveLearningSystem.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<div class="navbar-nav ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <div class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" id="accountDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                @User.Identity.Name
            </a>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="accountDropdown">
                <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">Manage</a></li>
                <li>
                    <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline">
                        <button type="submit" class="dropdown-item">Logout</button>
                    </form>
                </li>
            </ul>
        </div>
    }
    else
    {
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Login">Login</a>
        <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">Register</a>
    }
</div>
