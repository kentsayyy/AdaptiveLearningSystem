@model AdaptiveLearningSystem.Models.Enrollment
@{
    ViewData["Title"] = "Enroll Student";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-plus-fill me-2 text-success"></i>Enroll Student</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card" style="max-width:480px;">
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

            <div class="mb-3">
                <label asp-for="UserId" class="form-label fw-semibold">Student</label>
                <select asp-for="UserId" class="form-select" asp-items="ViewBag.Students">
                    <option value="">-- Select Student --</option>
                </select>
                <span asp-validation-for="UserId" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ModuleId" class="form-label fw-semibold">Module</label>
                <select asp-for="ModuleId" class="form-select" asp-items="ViewBag.Modules">
                    <option value="">-- Select Module --</option>
                </select>
                <span asp-validation-for="ModuleId" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Status" class="form-label fw-semibold">Status</label>
                <select asp-for="Status" class="form-select">
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-success fw-semibold">
                    <i class="bi bi-check-lg me-1"></i>Enroll
                </button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
