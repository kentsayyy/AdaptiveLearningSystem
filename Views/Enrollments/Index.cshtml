@model IEnumerable<AdaptiveLearningSystem.Models.Enrollment>
@{
    ViewData["Title"] = "Enrollments";
}

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-header-title">
        <span class="title-icon" style="background:#e6f7f1;">
            <i class="bi bi-person-check-fill text-teal"></i>
        </span>
        Enrollments
    </h1>
    <a asp-action="Create" class="btn btn-success px-4">
        <i class="bi bi-plus-lg me-1"></i>Enroll Student
    </a>
</div>

<!-- Table Card -->
<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table mb-0">
                    <thead>
                        <tr>
                            <th style="padding-left:1.5rem;width:48px;">#</th>
                            <th>Student</th>
                            <th>Module</th>
                            <th>Enrolled Date</th>
                            <th>Status</th>
                            <th style="padding-right:1.5rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td style="padding-left:1.5rem;color:#94a3b8;font-size:.82rem;">@i</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span style="width:34px;height:34px;border-radius:50%;background:#e6f7f1;display:inline-flex;align-items:center;justify-content:center;font-weight:700;font-size:.78rem;color:#0D9E6E;flex-shrink:0;">
                                            @(e.User?.FullName?.Substring(0,1).ToUpper() ?? "?")
                                        </span>
                                        <span style="color:#1e293b;font-weight:500;">@e.User?.FullName</span>
                                    </div>
                                </td>
                                <td style="color:#475569;">@e.Module?.Title</td>
                                <td style="color:#94a3b8;font-size:.82rem;">@e.EnrolledDate.ToShortDateString()</td>
                                <td>
                                    <span class="badge rounded-pill" style="background:@(e.Status == "Active" ? "#f0fdf4" : "#f8fafc");color:@(e.Status == "Active" ? "#15803d" : "#64748b");">
                                        <i class="bi bi-@(e.Status == "Active" ? "check-circle" : "dash-circle") me-1"></i>@e.Status
                                    </span>
                                </td>
                                <td style="padding-right:1.5rem;">
                                    <form asp-action="Delete" asp-route-id="@e.EnrollmentId" method="post" class="d-inline"
                                          onsubmit="return confirm('Remove this enrollment?')">
                                        <button class="btn btn-sm" style="background:#fff1f2;color:#be123c;border:none;" title="Remove">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-state-icon" style="background:#e6f7f1;">
                    <i class="bi bi-person-check" style="color:#0D9E6E;"></i>
                </div>
                <h6>No enrollments yet</h6>
                <p>Enroll students into modules to get them started. <a asp-action="Create" style="color:#0D9E6E;font-weight:600;">Enroll a student?</a></p>
            </div>
        }
    </div>
</div>
