@model IEnumerable<AdaptiveLearningSystem.Models.Enrollment>
@{
    ViewData["Title"] = "Enrollments";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-person-check-fill me-2 text-success"></i>Enrollments</h4>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success btn-sm"><i class="bi bi-plus-lg me-1"></i>Enroll Student</a>
    }
</div>

<div class="card">
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Student</th>
                            <th>Module</th>
                            <th>Enrolled Date</th>
                            <th>Status</th>
                            @if (User.IsInRole("Admin"))
                            {
                                <th>Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int i = 1; }
                        @foreach (var e in Model)
                        {
                            <tr>
                                <td class="text-muted small">@i</td>
                                <td><i class="bi bi-person-circle me-1 text-primary"></i>@e.User?.FullName</td>
                                <td>@e.Module?.Title</td>
                                <td class="small text-muted">@e.EnrolledDate.ToShortDateString()</td>
                                <td><span class="badge @(e.Status == "Active" ? "bg-success" : "bg-secondary")">@e.Status</span></td>
                                @if (User.IsInRole("Admin"))
                                {
                                    <td>
                                        <form asp-action="Delete" asp-route-id="@e.EnrollmentId" method="post" class="d-inline"
                                              onsubmit="return confirm('Remove this enrollment?')">
                                            <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </td>
                                }
                            </tr>
                            i++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-person-check fs-1"></i>
                <p class="mt-2">No enrollments yet.</p>
            </div>
        }
    </div>
</div>
