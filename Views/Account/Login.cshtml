@model AdaptiveLearningSystem.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<style>
    /* ─── AUTH BACKGROUND ─────────────────────────────────────────── */
    .auth-bg {
        min-height: 100vh;
        background-color: #f0f4f9;
        background-image:
            /* Faint ruled lines — notebook feel */
            repeating-linear-gradient(
                180deg,
                transparent,
                transparent 31px,
                rgba(11, 79, 216, 0.045) 31px,
                rgba(11, 79, 216, 0.045) 32px
            ),
            /* Subtle dot grid */
            radial-gradient(circle, rgba(13, 158, 110, 0.18) 1px, transparent 1px);
        background-size: 100% 32px, 28px 28px;
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* ─── WATERCOLOR BLOBS (very low opacity) ──────────────────────── */
    .auth-bg::before {
        content: "";
        position: absolute;
        inset: 0;
        background:
            radial-gradient(ellipse 520px 380px at 10% 15%,  rgba(11, 79, 216, 0.07)  0%, transparent 70%),
            radial-gradient(ellipse 420px 320px at 90% 80%,  rgba(13, 158, 110, 0.08) 0%, transparent 70%),
            radial-gradient(ellipse 300px 260px at 85% 12%,  rgba(11, 79, 216, 0.05)  0%, transparent 65%),
            radial-gradient(ellipse 260px 200px at 5%  85%,  rgba(13, 158, 110, 0.06) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
    }

    /* ─── CARD sits above everything ──────────────────────────────── */
    .auth-card {
        position: relative;
        z-index: 1;
    }

    /* ─── FLOATING SVG DECORATION ─────────────────────────────────── */
    .deco {
        position: absolute;
        pointer-events: none;
        z-index: 0;
    }
</style>

<div class="auth-bg">

    <!-- Graduation cap — top right -->
    <svg class="deco" style="width:96px; top:6%; right:7%; opacity:0.06;" viewBox="0 0 24 24" fill="none" stroke="#0B4FD8" stroke-width="1.4">
        <path d="M22 9L12 4 2 9l10 5 10-5z"/>
        <path d="M6 11.5v5c0 1.657 2.686 3 6 3s6-1.343 6-3v-5"/>
        <line x1="22" y1="9" x2="22" y2="14"/>
    </svg>

    <!-- Open book — bottom left -->
    <svg class="deco" style="width:110px; bottom:8%; left:5%; opacity:0.07;" viewBox="0 0 24 24" fill="none" stroke="#0D9E6E" stroke-width="1.4">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>

    <!-- Pencil — top left -->
    <svg class="deco" style="width:72px; top:14%; left:8%; opacity:0.07;" viewBox="0 0 24 24" fill="none" stroke="#0B4FD8" stroke-width="1.4">
        <path d="M12 20h9"/>
        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
    </svg>

    <!-- Star / award — bottom right -->
    <svg class="deco" style="width:80px; bottom:14%; right:6%; opacity:0.06;" viewBox="0 0 24 24" fill="none" stroke="#0D9E6E" stroke-width="1.4">
        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
    </svg>

    <!-- Atom / science — mid left -->
    <svg class="deco" style="width:64px; top:50%; left:3%; opacity:0.055;" viewBox="0 0 24 24" fill="none" stroke="#0B4FD8" stroke-width="1.4">
        <circle cx="12" cy="12" r="1"/>
        <ellipse cx="12" cy="12" rx="10" ry="4"/>
        <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(60 12 12)"/>
        <ellipse cx="12" cy="12" rx="10" ry="4" transform="rotate(120 12 12)"/>
    </svg>

    <!-- White card — EXACTLY as original, zero changes inside -->
    <div class="card shadow-lg auth-card" style="width:100%;max-width:420px;border-radius:16px;">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <i class="bi bi-mortarboard-fill text-primary fs-1"></i>
                <h3 class="fw-bold mt-2">AdaptLearn PH</h3>
                <p class="text-muted small">Sign in to your account</p>
            </div>

            <form asp-action="Login" method="post">
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Email</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control" placeholder="your@email.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" class="form-control" placeholder="••••••" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">Remember me</label>
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <hr />
            <p class="text-center small mb-0">
                Don't have an account? <a asp-controller="Account" asp-action="Register">Register here</a>
            </p>
            <div class="mt-3 p-2 rounded small text-muted" style="background:#f8f9fa;">
                <strong>Default Admin:</strong><br/>
                Email: <code>admin@adaptlearn.ph</code><br/>
                Password: <code>Admin@123</code>
            </div>
        </div>
    </div>
</div>
